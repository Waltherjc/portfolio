---
import { url } from '../lib/url';
const { href, label, hint = 'Download', external = false } = Astro.props;
const target = external ? href : url(href);
---

<a
  class="filerow"
  href={target}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class="filerow__label">{label}</span>
  <span class="filerow__hint">{hint}</span>
</a>
