---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TitleBlock from '../components/TitleBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import PartRow from '../components/PartRow.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  description="Mechanical engineering at Vanderbilt University. Formula SAE oil systems, suspension and roll structures, designed in CAD and built by hand."
>
  <div class="sheet sheet--wide hero">
    <div>
      <h1 class="hero__name">{site.name}</h1>
      <hr class="rule rule--full rule--draw" />
      <p class="hero__summary">{site.summary}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={url('portfolio')}>See the work</a>
        <a class="btn btn--outline" href={url('about')}>About me</a>
      </div>
    </div>
    <TitleBlock rows={site.titleBlock} />
  </div>

  <section class="sheet sheet--wide section">
    <SectionHead note={`${projects.length} projects`}>Selected work</SectionHead>
    <div class="parts">
      {projects.map((p, i) => <PartRow project={p} index={i} />)}
    </div>
  </section>

</Base>
